# Machine-specific scratch: cross-drive sync bookkeeping and D:-drive recovery staging
.sync_manifests/
.preserved_from_D/

# Python virtualenvs (machine-local; the demo backend venv is several GB)
.venv/
venv/

# Secrets — never commit
kaggle.json
**/kaggle.json

# Приватный спутник реестра метаданных совета: банковские реквизиты зарубежного
# консультанта и прочие персональные данные третьих лиц. Публичный реестр —
# council/METADATA.toml — остаётся в git.
council/METADATA.private.toml

# Cloudflare tunnel credentials (cert.pem / <tunnel-uuid>.json). Only the
# generated demo/cloudflared/config.yml.example is tracked.
.cloudflared/
demo/cloudflared/*.json
demo/cloudflared/cert.pem

# Demo access password (DEMO_PASSWORD) read by the demo launchers
demo/.demo-password

# Build cache: images downscaled to print resolution by md2gost.py
defense/docs/.print_cache/

# Intermediate bodies written by build_full_dissertation.py, and Word scratch files
thesis/assembly/_tmp_body/
*.tmp

# Runtime state written by the demo backend: patient case folders (originals,
# cached preprocessing, attention maps, verdicts) and the OD/fovea correction
# store. Real fundus images of real people — never commit them.
demo/server/data/
